# ============================================================
#  Kernel Wargame ── debug kernel config 片段
#  把 LV1~LV4 需要的「裁判」全部打開。配 virtme-ng 使用：
#
#    cd ~/Documents/linux_kernel        # 你的 kernel 7.0 源碼樹
#    vng -f ~/Documents/kernel-c-practice/wargame/qemu-sandbox/debug.config -b
#    vng -r .                           # 跑剛編好的 debug kernel
#
#  vng 會把這些選項合併進它產生的 base config，再編譯。
# ============================================================

# --- 總開關 ---
CONFIG_DEBUG_KERNEL=y

# --- LV1：在 atomic context（持 spinlock 等）裡睡眠 → 立刻噴 BUG ---
CONFIG_DEBUG_ATOMIC_SLEEP=y

# --- LV1 / LV2：lockdep——死鎖、鎖序錯誤、持鎖睡眠全抓 ---
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_LOCK_ALLOC=y

# --- LV4：oops/panic 能對到原始碼行號 + gdb 友善 ---
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_GDB_SCRIPTS=y
CONFIG_FRAME_POINTER=y

# --- LV2 / LV4 加分：KASAN——抓記憶體越界 / use-after-free ---
#  （較吃編譯時間與記憶體；想要快一點可以把下面兩行註解掉）
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y

# --- 其他有用的除錯（可選）---
CONFIG_PROVE_RCU=y
CONFIG_DEBUG_OBJECTS=y
